# Copy to backend/.env for local development. Never commit the real .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
LOG_LEVEL=INFO

# Local Docker Compose DB. On Render, use the Neon URL (ends with ?sslmode=require).
DATABASE_URL=postgres://shelfready:shelfready@localhost:5432/shelfready

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Demo account created by `python manage.py seed_catalog`
SEED_DEMO_PASSWORD=ShelfReady@2026

# AI (used from Block 7). Check model IDs in the Anthropic docs before use.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_VISION=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
AI_TIMEOUT_SECONDS=40
THROTTLE_AI=20/hour
THROTTLE_AI_SEARCH=30/hour
IMAGE_FETCH_TIMEOUT_SECONDS=10

# Celery: False in Docker (real worker), True on Render (no worker, runs inline)
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# Add-ons (used from Block 10)
EMBEDDINGS_ENABLED=True
LOOKALIKE_PHASH_MAX_DISTANCE=10
LOOKALIKE_TEXT_MIN_SIMILARITY=0.90
READINESS_MIN_IMAGE_SIDE=300
