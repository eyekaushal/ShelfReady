# Copy to frontend/.env for local development.
# Base URL of the Django API (no trailing slash). On Vercel, point this at the Render URL.
VITE_API_BASE_URL=http://localhost:8000/api

# Optional: Cloudinary unsigned upload preset, so uploaded pack photos get a permanent URL.
# Leave empty to use uploads only for "Fill from photo" (not stored).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
